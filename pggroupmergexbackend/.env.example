PORT=3000

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Database Engine Selection ('supabase' with automatic offline fallback to 'sqlite')
DB_TYPE=supabase

# BarTender Print configuration
BARTENDER_API_URL=http://localhost:5159/api
BARTENDER_PRINTER_NAME=ZDesigner ZT231-300dpi ZPL
PRINT_METHOD=auto
BARTENDER_LABEL_PATH=C:\Labels\Template.btw

# Microsoft 365 / Outlook SMTP Configuration
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=verify.software2040@pgel.in
SMTP_PASS=your_email_app_password
SMTP_FROM=verify.software2040@pgel.in
